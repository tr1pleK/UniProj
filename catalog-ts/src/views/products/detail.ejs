<%- include('../partials/header') %>

<div class="topbar"><a href="/products">← К списку</a></div>

<h1><%= product.name %></h1>
<p class="price"><%= product.price.toFixed(2) %> ₽</p>
<p class="muted">В наличии: <%= product.stock_quantity %> шт. · Добавлен: <%= product.created_at.toLocaleDateString('ru-RU') %></p>
<% if (product.description) { %>
    <p><%= product.description %></p>
<% } %>

<h2>Отзывы (<%= reviews.length %>)</h2>
<a class="btn" href="/products/<%= product.id %>/reviews/new">Добавить отзыв</a>

<div style="margin-top: 16px;">
    <% if (reviews.length === 0) { %>
        <p class="muted">Отзывов пока нет — будьте первым!</p>
    <% } %>
    <% reviews.forEach(function (r) { %>
        <div class="review">
            <div class="review-head">
                <strong><%= r.reviewer_name %></strong>
                <span class="stars"><%= '★'.repeat(r.rating) %><span style="color:#d1d5db"><%= '★'.repeat(5 - r.rating) %></span></span>
            </div>
            <% if (r.comment) { %><p><%= r.comment %></p><% } %>
            <p class="muted"><%= r.created_at.toLocaleDateString('ru-RU') %></p>
        </div>
    <% }); %>
</div>

<%- include('../partials/footer') %>
