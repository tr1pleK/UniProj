<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <title>Расписание</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav>
        <a href="/">Бронирование</a>
        <a href="/schedule">Расписание</a>
        <% if (user.is_admin) { %>
            <a href="/stats">Статистика</a>
        <% } %>
        <span><%= user.username %><% if (user.is_admin) { %> (админ)<% } %></span>
        <a href="/logout">Выйти</a>
    </nav>

    <% if (user.is_admin) { %>
        <h1>Все записи</h1>
    <% } else { %>
        <h1>Мои записи</h1>
    <% } %>

    <% if (days.length === 0) { %>
        <p>Нет предстоящих записей.</p>
    <% } else { %>
        <% days.forEach(day => { %>
            <h2><%= day.date %></h2>
            <table>
                <tr>
                    <th>Комната</th>
                    <th>Начало</th>
                    <th>Длительность</th>
                    <% if (user.is_admin) { %>
                        <th>Автор</th>
                    <% } %>
                    <th></th>
                </tr>
                <% day.items.forEach(booking => { %>
                    <tr>
                        <td><%= booking.room %></td>
                        <td><%= booking.start_time %></td>
                        <td><%= booking.duration %> ч.</td>
                        <% if (user.is_admin) { %>
                            <td><%= booking.user_name %></td>
                        <% } %>
                        <td>
                            <form method="POST" action="/cancel/<%= booking.id %>">
                                <button type="submit">Удалить</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </table>
        <% }); %>
    <% } %>
</body>
</html>
